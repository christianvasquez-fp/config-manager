<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>ConfigManager</PackageId>
    <Version>0.1.0</Version>
    <Authors>christianvasquez</Authors>
    <Description>Library to manage local .exe.config files for other applications.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>config;exe.config;app.config;configuration</PackageTags>
  </PropertyGroup>

</Project>
